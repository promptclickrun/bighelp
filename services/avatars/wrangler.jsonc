{
  "name": "bighelp-avatars",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "avatars.bighelp.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
