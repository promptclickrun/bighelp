// Local test harness only. Never deploy this configuration.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loopdy-link-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "APPLE_APP_ID": "ZWDGY4GYX9.app.loopdy.mobile",
    "PASSKEY_RP_ID": "link.loopdy.example",
    "PASSKEY_ORIGIN": "https://link.loopdy.example"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "loopdy-link-accounts-test",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "MARKETPLACE_RETIREMENT",
      "database_name": "loopdy-marketplace-retirement-test",
      "migrations_dir": "./marketplace-migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_LINKS",
        "class_name": "UserLink"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserLink"]
    }
  ]
}
