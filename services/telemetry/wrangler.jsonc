{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bighelp-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "telemetry.bighelp.app", "custom_domain": true }],
  // Low sampling, and the code logs fixed codes only (never request data or exception text).
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } },
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "limits": { "cpu_ms": 100 },
  // Secrets, set by the maintainer with `wrangler secret put` (see azure/README.md):
  //   APPINSIGHTS_CONNECTION_STRING  where batches are forwarded
  //   IP_HASH_KEY                    key for the per-network rate limit hash
  // The namespace_id values only need to be unique inside the Cloudflare account.
  "ratelimits": [
    { "name": "RL_ID", "namespace_id": "710001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_NET", "namespace_id": "710002", "simple": { "limit": 600, "period": 60 } }
  ]
}
